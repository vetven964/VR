# ចម្លងឯកសារនេះទៅជា .env រួចបំពេញព័ត៌មានខាងក្រោម

# Token ដែលបានពី @BotFather នៅលើ Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# Chat ID របស់ Channel ឬ Group ដែលចង់ផ្ញើ Signal ទៅ
# (Channel ID ច្រើនចាប់ផ្តើមដោយ -100...)
CHAT_ID=-1001234567890

# ពាក្យសម្ងាត់សម្រាប់ចូលប្រើ Dashboard (ប្តូរជាពាក្យសម្ងាត់ផ្ទាល់ខ្លួនរបស់បង)
ADMIN_PASSWORD=changeme123

# Port សម្រាប់ server (Railway/Render នឹងកំណត់ PORT ឲ្យស្វ័យប្រវត្តិ)
PORT=3000

# API Key ឥតគិតថ្លៃពី https://twelvedata.com (Sign up, គ្មាន Card)
# ត្រូវការសម្រាប់ Data Source "Twelve Data" (ប្រភេទទូទៅ)
TWELVEDATA_API_KEY=your_twelvedata_key_here

# --- ជម្រើស: MetaApi.cloud (សម្រាប់តម្លៃដូច MT5 Broker បង 100%) ---
# Sign up ឥតគិតថ្លៃនៅ https://app.metaapi.cloud (1 Account ឥតគិតថ្លៃ)
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here
METAAPI_REGION=new-york
